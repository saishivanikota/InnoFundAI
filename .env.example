# Backend configuration
PORT=5001
JWT_SECRET=replace_with_a_long_random_secret
NODE_ENV=development

# Database connection (PostgreSQL recommended for production; local SQLite fallback is used automatically if this is not set)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/research_platform

# Google Gemini AI key (optional; AI features will fall back gracefully if not configured)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend configuration
VITE_API_BASE_URL=http://localhost:5001
